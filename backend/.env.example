# ── OpenAI (required for moderation + AI features) ──────────────────
OPENAI_API_KEY=
# Reasoning model for thread analysis, vetting, coaching, digests
OPENAI_MODEL=gpt-4o-mini
# OPENAI_MODERATION_MODEL=omni-moderation-latest
# OPENAI_TIMEOUT_SECONDS=20

# ── Firebase (Firestore + Storage) ──────────────────────────────────
# Path to a service-account JSON (relative to backend/ or absolute). Never commit it.
FIRESTORE_CREDENTIALS_PATH=
# Only needed if your Firestore database isn't named "(default)"
FIRESTORE_DATABASE_ID=
FIREBASE_STORAGE_BUCKET=

# ── Discord (optional; user-account token for discord.py-self) ──────
DISCORD_TOKEN=
# true = only ingest DMs / group DMs; false = also server channels
DISCORD_DMS_ONLY=true

# ── Instagram (optional; instagrapi) ────────────────────────────────
# Used first if set (browser sessionid cookie). Falls back to username/password if rejected.
INSTAGRAM_SESSION_ID=
# Recommended for long-lived use: logs in once, saves backend/instagram_session.json,
# and reuses it on restart (only logs in again if Instagram rejects the saved session).
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
# Only if the account has authenticator-app 2FA: the base32 setup secret (not a 6-digit code)
INSTAGRAM_TOTP_SEED=
INSTAGRAM_POLL_INTERVAL=30

# ── API ─────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
# Comma-separated origins, or * for any
CORS_ORIGINS=*
# MODERATION_WORKERS=4
# THREAD_DEBOUNCE_SECONDS=30
