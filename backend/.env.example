# ── OpenAI (required for moderation + AI features) ──────────────────
OPENAI_API_KEY=
# Reasoning model for thread analysis, vetting, coaching, digests
OPENAI_MODEL=gpt-4o-mini
# OPENAI_MODERATION_MODEL=omni-moderation-latest
# OPENAI_TIMEOUT_SECONDS=20

# ── Firebase (Firestore + Storage) ──────────────────────────────────
# Path to a service-account JSON (relative to backend/ or absolute). Never commit it.
FIRESTORE_CREDENTIALS_PATH=
FIREBASE_STORAGE_BUCKET=

# ── Discord (optional; user-account token for discord.py-self) ──────
DISCORD_TOKEN=
# true = only ingest DMs / group DMs; false = also server channels
DISCORD_DMS_ONLY=true

# ── Instagram (optional; sessionid cookie for instagrapi) ───────────
INSTAGRAM_SESSION_ID=
INSTAGRAM_POLL_INTERVAL=30

# ── API ─────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
# Comma-separated origins, or * for any
CORS_ORIGINS=*
# MODERATION_WORKERS=4
# THREAD_DEBOUNCE_SECONDS=30
